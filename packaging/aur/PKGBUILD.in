# Maintainer: vertopolkaLF <https://github.com/vertopolkaLF>
#
# Generated by build-linux.sh from packaging/aur/PKGBUILD.in; edit the template.
pkgname=codex-minibar-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Tray companion for AI subscription usage limits (Codex, Claude Code, Cursor and more)'
arch=('x86_64')
url='https://github.com/vertopolkaLF/codex-minibar'
license=('Apache-2.0')
# GPUI loads xkbcommon, Wayland, X11 and Vulkan at runtime.
depends=('glibc' 'gcc-libs' 'openssl' 'ca-certificates' 'bzip2' 'zlib' 'zstd' 'xz' 'dbus' 'xdg-utils'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb'
         'vulkan-icd-loader' 'fontconfig' 'freetype2')
optdepends=('xdg-desktop-portal: desktop settings, accent color and autostart'
            'gnome-shell-extension-appindicator: tray icon on GNOME')
provides=('codex-minibar')
conflicts=('codex-minibar')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/codex-minibar-$pkgver-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "codex-minibar-$pkgver"
    install -d "$pkgdir/usr"
    cp -R bin share "$pkgdir/usr/"
    chmod 755 "$pkgdir/usr/bin/codex-minibar"
    install -Dm644 share/doc/codex-minibar/LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
